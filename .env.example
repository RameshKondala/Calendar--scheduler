# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

FLASK_ENV=development
BUSINESS_TIMEZONE=America/Chicago

# Owner-only endpoints check for "Authorization: Bearer <OWNER_ACCESS_TOKEN>".
# This is a placeholder until Jose's Microsoft Entra/MSAL auth is wired in.
OWNER_ACCESS_TOKEN=change-me-local-dev-token

# Leave OPENAI_API_KEY unset to use the FakeIntentInterpreter locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8

# Microsoft Graph credentials (Jose's integration). Leave OUTLOOK_GATEWAY=fake
# until the real gateway implementation is registered in app/__init__.py.
OUTLOOK_GATEWAY=fake
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CALENDAR_ID=
GRAPH_TIMEOUT_SECONDS=8

RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_BOOKING_PER_MINUTE=10
