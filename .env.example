# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

FLASK_ENV=development
BUSINESS_TIMEZONE=America/Chicago

# Signs the Flask session cookie and appointment confirmation tokens.
# The default below is fine for local dev only -- set a real random value
# for anything beyond your own machine (e.g. `python -c "import secrets;
# print(secrets.token_hex(32))"`).
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Two ways to authenticate as owner (see app/routes/auth.py):
# 1. OWNER_ACCESS_TOKEN: a shared-secret bearer token, for local dev/CI only.
OWNER_ACCESS_TOKEN=change-me-local-dev-token
# 2. Real Microsoft sign-in via MSAL (requires OUTLOOK_GATEWAY=graph below),
#    restricted to these work/school account usernames (comma-separated).
OWNER_ALLOWED_UPNS=owner@yourtenant.onmicrosoft.com

# Leave OPENAI_API_KEY unset to use the FakeIntentInterpreter locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8

# Microsoft Graph credentials. Leave OUTLOOK_GATEWAY=fake for local dev with
# no Azure tenant; set to "graph" once these are filled in to use the real
# GraphOutlookGateway with delegated (signed-in owner) MSAL authentication.
OUTLOOK_GATEWAY=fake
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CALENDAR_ID=
GRAPH_TIMEOUT_SECONDS=8

RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_BOOKING_PER_MINUTE=10
